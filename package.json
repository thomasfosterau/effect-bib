{
  "$schema": "https://www.schemastore.org/package",
  "name": "reference-manager-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/biblio: CSL-JSON bibliographic records, checksummed identifiers, BibTeX / RIS / CSV / CSL-JSON parsing, same-work dedup scoring, citation rendering and Crossref / OpenAlex / OpenLibrary lookup, extracted from the website application.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "bash scripts/release.sh",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@thomasfosterau/biblio": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.18.0"
}
