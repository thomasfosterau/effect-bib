{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/effect-bib/src/index.ts",
    "packages/effect-bib/src/sources/index.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/*/tests/**/*.types.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/docs/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      { "name": "effect-bib", "patterns": ["packages/effect-bib/**"] },
      { "name": "dist-consumer", "patterns": ["tests/dist-consumer/**"] }
    ],
    "rules": [
      { "from": "effect-bib", "allow": [] },
      { "from": "dist-consumer", "allow": ["effect-bib"] }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "packages/effect-bib/coverage/coverage-final.json"
  }
}
